{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/get-started",
      "destination": "/get-started/index.html"
    },
    {
      "source": "/get-started/",
      "destination": "/get-started/index.html"
    },
    {
      "source": "/how-it-works",
      "destination": "/how-it-works/index.html"
    },
    {
      "source": "/how-it-works/",
      "destination": "/how-it-works/index.html"
    },
    {
      "source": "/evidence",
      "destination": "/evidence/index.html"
    },
    {
      "source": "/evidence/",
      "destination": "/evidence/index.html"
    },
    {
      "source": "/manifesto",
      "destination": "/manifesto/index.html"
    },
    {
      "source": "/manifesto/",
      "destination": "/manifesto/index.html"
    },
    {
      "source": "/review",
      "destination": "/review/index.html"
    },
    {
      "source": "/review/",
      "destination": "/review/index.html"
    },
    {
      "source": "/docs",
      "destination": "/docs/index.html"
    },
    {
      "source": "/docs/",
      "destination": "/docs/index.html"
    },
    {
      "source": "/docs/first-application",
      "destination": "/docs/first-application/index.html"
    },
    {
      "source": "/docs/first-application/",
      "destination": "/docs/first-application/index.html"
    },
    {
      "source": "/docs/troubleshooting",
      "destination": "/docs/troubleshooting/index.html"
    },
    {
      "source": "/docs/troubleshooting/",
      "destination": "/docs/troubleshooting/index.html"
    },
    {
      "source": "/docs/availability",
      "destination": "/docs/availability/index.html"
    },
    {
      "source": "/docs/availability/",
      "destination": "/docs/availability/index.html"
    },
    {
      "source": "/support",
      "destination": "/support/index.html"
    },
    {
      "source": "/support/",
      "destination": "/support/index.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug/index.html"
    },
    {
      "source": "/blog/:slug/",
      "destination": "/blog/:slug/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/analytics-config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "buildCommand": "npm run build"
}
